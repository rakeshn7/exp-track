# EXPTRACK — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file — it is gitignored.

# Server Port (default: 3000)
PORT=3000

# -----------------------------------------------
# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# -----------------------------------------------
# JWT Session Secret (REQUIRED)
# Generate a strong secret with: openssl rand -hex 32
# Set this in Render → Environment → Add environment variable
# -----------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-string

# -----------------------------------------------
# CORS Allowed Origin (REQUIRED for production)
# Set to your deployed Render URL. Comma-separate multiple origins.
# Example: https://exptrack.onrender.com
# For local dev: http://localhost:3000
# -----------------------------------------------
ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------
# Gmail / SMTP Configuration for Password Reset OTP
# To deliver 6-digit OTP codes directly to user Gmail accounts:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com)
# 2. Go to: Security → 2-Step Verification → App Passwords (or visit: https://myaccount.google.com/apppasswords)
# 3. Create an app password for "EXPTRACK" and copy the 16-character code
# 4. Fill in your Gmail and App Password below:
# -----------------------------------------------
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
# Optional overrides:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

