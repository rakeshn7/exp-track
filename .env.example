# EXPTRACK — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file — it is gitignored.

# Server Port (default: 3000)
PORT=3000

# -----------------------------------------------
# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# -----------------------------------------------
# JWT Session Secret (REQUIRED)
# Generate a strong secret with: openssl rand -hex 32
# Set this in Render → Environment → Add environment variable
# -----------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-string

# -----------------------------------------------
# CORS Allowed Origin (REQUIRED for production)
# Set to your deployed Render URL. Comma-separate multiple origins.
# Example: https://exptrack.onrender.com
# For local dev: http://localhost:3000
# -----------------------------------------------
ALLOWED_ORIGIN=http://localhost:3000
